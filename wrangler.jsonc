{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "awr-portal",
  "compatibility_date": "2026-09-09",
  "routes": [
    {
      "pattern": "asuniquegroup.com/awr*",
      "zone_name": "asuniquegroup.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}